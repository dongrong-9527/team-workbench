# Operator-owned 0600, read by systemd. No secrets needed in this example.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=https://EXAMPLE_DOMAIN
DATABASE_PATH=/var/lib/workbench/workbench.sqlite
ATTACHMENT_PATH=/var/lib/workbench/attachments
RELEASE_VERSION=EXAMPLE_VERSION
# Keep attachment caps consistent with ops/backup.env.example.
